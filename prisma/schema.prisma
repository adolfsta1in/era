// Схема БД демо-шаблона стоматологии.
// PostgreSQL: в продакшене — Neon (через Vercel), локально — `npx prisma dev` или та же Neon-база (см. docs/DEPLOY.md).
// Локализованные тексты хранятся в Json вида { "ru": "...", "ky": "..." }.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Настройки клиники. Всегда одна строка с id = 1.
model ClinicSettings {
  id                 Int      @id @default(1)
  name               String
  shortName          String
  tagline            Json
  description        Json
  about              Json
  logoUrl            String?
  phones             Json
  whatsapp           String
  telegram           String
  instagram          String
  email              String
  address            Json
  addressNote        Json
  lat                Float
  lng                Float
  twoGisUrl          String
  mapEmbedUrl        String
  workingHours       Json
  theme              String   @default("mint")
  foundedYear        Int
  patientsCount      Int
  rating             Float
  bookingLeadMinutes Int      @default(120)
  bookingHorizonDays Int      @default(30)
  slotStepMinutes    Int      @default(15)
  legalName          String
  legalInn           String
  updatedAt          DateTime @updatedAt
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      Json
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  categoryId       String
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name             Json
  shortDescription Json
  description      Json
  durationMin      Int
  priceFrom        Int
  priceTo          Int?
  isPopular        Boolean         @default(false)
  isActive         Boolean         @default(true)
  sortOrder        Int             @default(0)
  doctors          DoctorService[]
  appointments     Appointment[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([categoryId, sortOrder])
}

model Doctor {
  id              String              @id @default(cuid())
  slug            String              @unique
  name            Json
  specialty       Json
  bio             Json
  /// Массив { ru, ky }
  education       Json
  experienceSince Int
  photoUrl        String?
  isActive        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  services        DoctorService[]
  scheduleRules   ScheduleRule[]
  exceptions      ScheduleException[]
  appointments    Appointment[]
  bookedSlots     BookedSlot[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model DoctorService {
  doctorId  String
  serviceId String
  doctor    Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([doctorId, serviceId])
  @@index([serviceId])
}

/// Недельный шаблон графика. Время — минуты от полуночи по Бишкеку.
model ScheduleRule {
  id            String @id @default(cuid())
  doctorId      String
  doctor        Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  /// 0 — воскресенье … 6 — суббота
  weekday       Int
  startMin      Int
  endMin        Int
  breakStartMin Int?
  breakEndMin   Int?

  @@unique([doctorId, weekday])
}

/// Исключение из графика на конкретную дату (YYYY-MM-DD по Бишкеку).
/// type: DAY_OFF — выходной/отпуск; CUSTOM_HOURS — особые часы.
model ScheduleException {
  id            String  @id @default(cuid())
  doctorId      String
  doctor        Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date          String
  type          String
  startMin      Int?
  endMin        Int?
  breakStartMin Int?
  breakEndMin   Int?
  note          String?

  @@unique([doctorId, date])
}

/// status: NEW | CONFIRMED | COMPLETED | CANCELLED | NO_SHOW
model Appointment {
  id           String       @id @default(cuid())
  publicCode   String       @unique
  serviceId    String
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  doctorId     String
  doctor       Doctor       @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  startAt      DateTime
  endAt        DateTime
  patientName  String
  patientPhone String
  comment      String?
  status       String       @default("NEW")
  source       String       @default("web")
  locale       String       @default("ru")
  consentAt    DateTime?
  ip           String?
  bookedSlots  BookedSlot[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([doctorId, startAt])
  @@index([startAt])
  @@index([status])
  @@index([patientPhone])
}

/// Занятые ячейки сетки (шаг — slotStepMinutes). Уникальность (врач, начало ячейки)
/// на уровне БД исключает пересекающиеся записи к одному врачу.
model BookedSlot {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  slotStart     DateTime

  @@unique([doctorId, slotStart])
  @@index([appointmentId])
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  text        Json
  rating      Int      @default(5)
  serviceName Json?
  isDemo      Boolean  @default(true)
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Faq {
  id        String @id @default(cuid())
  question  Json
  answer    Json
  sortOrder Int    @default(0)
}

model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Кейс «До и после» на главной: врач добавляет его в админке (фото + описание).
model BeforeAfterCase {
  id          String   @id @default(cuid())
  title       Json
  description Json
  beforeUrl   String
  afterUrl    String
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
