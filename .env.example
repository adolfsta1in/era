# База данных — PostgreSQL.
# Продакшен: Neon, подключённый в Vercel (Storage → Neon) — DATABASE_URL и DATABASE_URL_UNPOOLED
# Vercel пропишет сам. Локально: `npx prisma dev -n era -d` и вставить выданную строку postgres://…
# (или строку от Neon-ветки для разработки). См. docs/DEPLOY.md.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Только для локального `prisma dev`: он держит одно соединение. На Vercel/Neon не задавать.
DATABASE_POOL_MAX="1"

# Публичный адрес сайта без слэша в конце (нужен для SEO, sitemap, ссылок в Telegram).
SITE_URL="http://localhost:3000"

# Вход в админку /admin. Пароль — любой надёжный. SESSION_SECRET — случайная строка от 32 символов:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD="change-me"
SESSION_SECRET="replace-with-random-64-hex-chars-replace-with-random-64-hex"

# Уведомления о новых записях в Telegram (необязательно). Пусто — уведомления выключены.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Vercel Blob для загрузки фото врачей и логотипа на Vercel (необязательно локально).
BLOB_READ_WRITE_TOKEN=""
